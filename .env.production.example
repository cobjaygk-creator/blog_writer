# Copy to .env.production on the Oracle VM (never commit real secrets)
NEXT_PUBLIC_APP_URL=http://YOUR_PUBLIC_IP:3000
AUTH_URL=http://YOUR_PUBLIC_IP:3000
AUTH_SECRET=replace-with-openssl-rand-hex-32
NEXT_PUBLIC_STUDIO_UI=1
INTEGRATIONS_ALLOW_FALLBACK=true

# Filled by docker-compose; override if using external DB
# DATABASE_URL=postgresql://blog:PASSWORD@db:5432/blog_writer?schema=public

ADMIN_EMAILS=you@example.com
SECRETS_ENCRYPTION_KEY=

# LLM / Vision (required for real drafts)
LLM_API_KEY=
LLM_GPT_API_KEY=
LLM_GEMINI_API_KEY=
VISION_API_KEY=

# Optional storage — without S3, local uploads volume is used
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=

# Optional
UNSPLASH_ACCESS_KEY=
HELICONE_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
