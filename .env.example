# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# New Cut (separate product — deep link only)
NEXT_PUBLIC_NEW_CUT_URL=https://newcut.app

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blog_writer?schema=public

# LLM / Vision — vendor-agnostic keys (wire adapters in app code)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=gpt-4o-mini

# S3-compatible object storage
STORAGE_ENDPOINT=
STORAGE_REGION=ap-northeast-2
STORAGE_BUCKET=blog-writer
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
