# App (Ditodio control plane — blog + shorts entitlements)
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000
# Production SSO across subdomains: AUTH_COOKIE_DOMAIN=.ditodio.com
AUTH_COOKIE_DOMAIN=

# New Cut / shorts app (Ditodio product surface)
# Local: http://127.0.0.1:5173  |  Hosted: https://shorts.ditodio.com
NEXT_PUBLIC_NEW_CUT_URL=http://127.0.0.1:5173

# Platform API (New Cut server → this hub). Must match new_cut PLATFORM_* values.
PLATFORM_SERVICE_TOKEN=
# Defaults to AUTH_SECRET when empty
PLATFORM_HANDOFF_SECRET=

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blog_writer?schema=public

# Integrations policy
# true(default): missing keys / provider failures use local fallback
# false: fail hard (recommended for production)
INTEGRATIONS_ALLOW_FALLBACK=true
LLM_TIMEOUT_MS=120000
VISION_TIMEOUT_MS=45000
STORAGE_TIMEOUT_MS=30000
LLM_MAX_TOKENS=3500
VISION_MAX_TOKENS=300
UPLOAD_MAX_BYTES=8388608
UPLOAD_MAX_IMAGES_PER_POST=20

# Comma-separated emails that bypass plan usage limits (empty = none)
UNLIMITED_USER_EMAILS=

# Admin bootstrap (comma-separated). These emails get role=admin on login.
ADMIN_EMAILS=

# AES-256 key for admin-managed IntegrationSecret (64 hex chars recommended)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_KEY=

# Toss Payments (billing)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=
BILLING_ENABLED=true

# LLM / Vision — OpenAI-compatible HTTP
# Legacy single-provider keys (still used as fallback for GPT / Vision)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Dual draft providers (worklog / product). Prefer these over LLM_* for GPT.
LLM_GPT_API_KEY=
LLM_GPT_BASE_URL=https://api.openai.com/v1
LLM_GPT_MODEL=gpt-4o-mini

# Gemini via OpenAI-compatible endpoint
# https://ai.google.dev/gemini-api/docs/openai
LLM_GEMINI_API_KEY=
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_GEMINI_MODEL=gemini-2.0-flash

VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=gpt-4o-mini

# Topic-mode stock photos (default image source for topic wizard)
# https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=

# Topic-mode AI image generation (optional advanced path)
# Falls back to LLM_API_KEY / LLM_BASE_URL when unset
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=
IMAGE_GEN_MODEL=gpt-image-1
IMAGE_GEN_SIZE=1024x1024
IMAGE_GEN_TIMEOUT_MS=90000

# Optional product research (falls back to DuckDuckGo snippets + LLM)
TAVILY_API_KEY=

# S3-compatible object storage
STORAGE_ENDPOINT=
STORAGE_REGION=ap-northeast-2
STORAGE_BUCKET=blog-writer
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
