# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# New Cut (separate product — deep link only)
# Local: http://127.0.0.1:5173  |  Hosted (when available): https://newcut.app
NEXT_PUBLIC_NEW_CUT_URL=http://127.0.0.1:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blog_writer?schema=public

# Integrations policy
# true(default): missing keys / provider failures use local fallback
# false: fail hard (recommended for production)
INTEGRATIONS_ALLOW_FALLBACK=true
LLM_TIMEOUT_MS=45000
VISION_TIMEOUT_MS=45000
STORAGE_TIMEOUT_MS=30000
LLM_MAX_TOKENS=2500
VISION_MAX_TOKENS=300
UPLOAD_MAX_BYTES=8388608
UPLOAD_MAX_IMAGES_PER_POST=20

# Comma-separated emails that bypass plan usage limits
UNLIMITED_USER_EMAILS=test@test.com

# LLM / Vision — OpenAI-compatible HTTP
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=gpt-4o-mini

# Optional product research (falls back to DuckDuckGo snippets + LLM)
TAVILY_API_KEY=

# S3-compatible object storage
STORAGE_ENDPOINT=
STORAGE_REGION=ap-northeast-2
STORAGE_BUCKET=blog-writer
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
