generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  free
  lite
  pro
}

enum UserRole {
  user
  admin
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  expired
  paused
}

enum BillingInterval {
  monthly
  yearly
}

enum PaymentStatus {
  pending
  paid
  failed
  canceled
  refunded
  partial_refund
}

enum PostStatus {
  collecting
  draft
  published
  archived
}

enum TemplateKind {
  header
  footer
}

enum ImportJobStatus {
  pending
  listing
  fetching
  learning
  completed
  failed
}

enum GenerationJobStatus {
  pending
  running
  completed
  failed
}

enum GenerationJobKind {
  generate
  generate_topic
  generate_reference
}

/// Wizard content mode for a post
enum PostMode {
  worklog
  topic
  product
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  passwordHash      String
  plan              Plan           @default(free)
  role              UserRole       @default(user)
  planOverrideCode  String?
  planOverrideNote  String?
  planOverrideUntil DateTime?
  suspendedAt       DateTime?
  tossCustomerKey   String?        @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  brands            Brand[]
  subscriptions     Subscription[]
  payments          Payment[]
  usageDaily        UsageDaily[]
  usagePeriods      UsagePeriod[]
  auditLogs         AdminAuditLog[] @relation("AuditActor")
  generationJobs    PostGenerationJob[]
}

/// Umbrella product registry (Ditodio control plane)
model Product {
  code      String   @id
  name      String
  createdAt DateTime @default(now())
}

model Brand {
  id            String          @id @default(cuid())
  userId        String
  name          String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourcePosts   SourcePost[]
  styleProfile  StyleProfile?
  posts         Post[]
  templates     BrandTemplate[]
  importJobs    SourceImportJob[]
  reviewCaches  ProductReviewCache[]

  @@index([userId])
}

/// Cached web-review themes for a brand + product name (TTL-based refresh).
model ProductReviewCache {
  id               String   @id @default(cuid())
  brandId          String
  productName      String
  /// { productName, themes: [{ theme, sentiment, sourceCount }], fetchedAt }
  reviewThemesJson Json
  fetchedAt        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  brand            Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, productName])
  @@index([brandId])
}

model BrandTemplate {
  id        String       @id @default(cuid())
  brandId   String
  name      String
  kind      TemplateKind
  html      String       @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  brand     Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  headerPosts Post[]     @relation("PostHeaderTemplate")
  footerPosts Post[]     @relation("PostFooterTemplate")

  @@index([brandId])
  @@index([brandId, kind])
}

model SourcePost {
  id          String    @id @default(cuid())
  brandId     String
  rawText     String
  /// Optional origin URL when the source was imported from the web
  sourceUrl   String?
  title       String?
  publishedAt DateTime?
  /// External post id (e.g. Naver logNo)
  externalId  String?
  /// Indexed product facets for learned-content supplement (e.g. "카니발 KA4")
  vehicle     String?
  /// e.g. "바디킷", "머플러팁"
  part        String?
  /// Normalized key: slug(vehicle)|slug(part)
  productKey  String?
  createdAt   DateTime  @default(now())
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([brandId, sourceUrl])
  @@index([brandId, externalId])
  @@index([brandId, productKey])
}

model SourceImportJob {
  id           String          @id @default(cuid())
  brandId      String
  blogId       String
  status       ImportJobStatus @default(pending)
  targetCount  Int             @default(100)
  listedCount  Int             @default(0)
  fetchedCount Int             @default(0)
  skippedCount Int             @default(0)
  failedCount  Int             @default(0)
  /// Queue items: [{ logNo, url, title?, publishedAt?, status, error? }]
  itemsJson    Json
  error        String?
  autoLearn    Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  brand        Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([brandId, status])
}

model StyleProfile {
  id            String   @id @default(cuid())
  brandId       String   @unique
  /// Human-readable style guide from the LLM
  summaryText   String
  /// Few-shot anchors: [{ "excerpt": "...", "sourcePostId": "..." }]
  sampleAnchors Json
  /// Structured traits for stabler regeneration (optional JSON object)
  traitsJson    Json?
  /// Pristine learned traits, untouched by per-trait on/off toggles — lets a
  /// disabled trait (see traitsJson) be restored without re-running learning.
  rawTraitsJson Json?
  version       Int      @default(1)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

model Post {
  id                String         @id @default(cuid())
  brandId           String
  /// Wizard mode: worklog | topic | product
  mode              PostMode       @default(worklog)
  title             String?
  /// JSON string array of title candidates when generated
  titleCandidates   Json?
  body              String?
  keyword           String?
  /// Optional user-provided product highlights / selling points
  productHighlights String?        @db.Text
  /// Cached product fact card: { productName, highlights[], source, caution? }
  productFactsJson  Json?
  /// Caption voice for vision captions. Null / brand sentinel → StyleTraits.tone
  captionTone       String?
  status            PostStatus     @default(collecting)
  /// External blog URL after user published (manual archive; no auto-post)
  publishedUrl      String?
  publishedAt       DateTime?
  /// naver | tistory | other
  publishPlatform   String?
  headerTemplateId  String?
  footerTemplateId  String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  brand             Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  headerTemplate    BrandTemplate? @relation("PostHeaderTemplate", fields: [headerTemplateId], references: [id], onDelete: SetNull)
  footerTemplate    BrandTemplate? @relation("PostFooterTemplate", fields: [footerTemplateId], references: [id], onDelete: SetNull)
  images            PostImage[]
  drafts            PostDraft[]
  generationJobs    PostGenerationJob[]

  @@index([brandId])
  @@index([status])
  @@index([brandId, mode])
  @@index([headerTemplateId])
  @@index([footerTemplateId])
}

/// Async post draft generation (client-driven tick, like SourceImportJob)
model PostGenerationJob {
  id          String               @id @default(cuid())
  postId      String
  userId      String
  kind        GenerationJobKind
  status      GenerationJobStatus  @default(pending)
  /// assemble | reference | research | plan | images | draft_gpt | draft_gemini | draft | persist
  phase       String               @default("pending")
  requestJson Json
  contextJson Json?
  resultJson  Json?
  error       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  post        Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, status])
  @@index([userId, status])
}

/// Candidate drafts from dual providers (GPT / Gemini). Selected draft syncs to Post.title/body.
model PostDraft {
  id              String   @id @default(cuid())
  postId          String
  /// "gpt" | "gemini"
  provider        String
  modelId         String
  title           String?
  titleCandidates Json?
  /// TipTap/editor HTML body
  body            String   @db.Text
  tokenUsage      Json?
  isSelected      Boolean  @default(false)
  /// Soft error note when this provider failed (row may be omitted instead)
  error           String?
  createdAt       DateTime @default(now())
  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([postId, isSelected])
  @@index([postId, provider])
}

model PostImage {
  id         String   @id @default(cuid())
  postId     String
  imageUrl   String
  caption    String?
  orderIndex Int      @default(0)
  /// Same non-null value = photo group (max 4 images). Null = standalone.
  groupId    String?
  /// Optional attribution: { provider, author, authorUrl, pageUrl, license }
  sourceMeta Json?
  createdAt  DateTime @default(now())
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([postId, orderIndex])
  @@index([postId, groupId])
}

model PlanProduct {
  id                     String         @id @default(cuid())
  /// Umbrella catalog: ditodio (unified posts + shorts)
  productCode            String         @default("ditodio")
  code                   String
  name                   String
  description            String?        @db.Text
  sortOrder              Int            @default(0)
  isPublic               Boolean        @default(true)
  isPurchasable          Boolean        @default(false)
  brandsLimit            Int
  sourcePostsPerBrand    Int
  postsPerDay            Int
  imagesPerPost          Int
  generatesPerDay        Int            @default(20)
  dualGenerationEnabled  Boolean        @default(true)
  /// Unified entitlements: postsPerMonth, shortsPerMonth, …
  limitsJson             Json           @default("{}")
  priceMonthlyKrw        Int            @default(0)
  priceYearlyKrw         Int?
  currency               String         @default("KRW")
  taxIncluded            Boolean        @default(true)
  tossBillingProductCode String?
  trialDays              Int            @default(0)
  active                 Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  subscriptions          Subscription[]

  @@unique([productCode, code])
  @@index([productCode])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  planProductId      String
  productCode        String             @default("ditodio")
  status             SubscriptionStatus
  interval           BillingInterval    @default(monthly)
  tossBillingKey     String?
  tossCustomerKey    String
  tossOrderIdPrefix  String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  trialEndsAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planProduct        PlanProduct        @relation(fields: [planProductId], references: [id])
  payments           Payment[]

  @@index([userId])
  @@index([userId, productCode])
  @@index([status])
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  status         PaymentStatus
  amountKrw      Int
  vatKrw         Int           @default(0)
  currency       String        @default("KRW")
  tossPaymentKey String?       @unique
  tossOrderId    String        @unique
  method         String?
  receiptUrl     String?
  failCode       String?
  failMessage    String?
  paidAt         DateTime?
  refundedAt     DateTime?
  rawWebhookJson Json?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([subscriptionId])
}

model Promotion {
  id              String    @id @default(cuid())
  code            String    @unique
  percentOff      Int?
  amountOffKrw    Int?
  durationMonths  Int       @default(1)
  maxRedemptions  Int?
  redeemedCount   Int       @default(0)
  applicablePlans String[]
  activeFrom      DateTime?
  activeUntil     DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model UsageDaily {
  id              String   @id @default(cuid())
  userId          String
  day             DateTime
  postsCreated    Int      @default(0)
  generates       Int      @default(0)
  llmInputTokens  Int      @default(0)
  llmOutputTokens Int      @default(0)
  imagesUploaded  Int      @default(0)
  estCostKrw      Int      @default(0)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
}

/// Monthly (or billing-period) meter: posts | shorts | generates
model UsagePeriod {
  id          String   @id @default(cuid())
  userId      String
  productCode String   @default("ditodio")
  periodStart DateTime
  meter       String
  used        Int      @default(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productCode, periodStart, meter])
  @@index([meter, periodStart])
  @@index([userId, periodStart])
}

model ApiUsageDaily {
  id          String   @id @default(cuid())
  day         DateTime
  slot        String
  requests    Int      @default(0)
  successes   Int      @default(0)
  failures    Int      @default(0)
  inputUnits  Int      @default(0)
  outputUnits Int      @default(0)
  estCostKrw  Int      @default(0)

  @@unique([day, slot])
  @@index([slot, day])
}

model IntegrationSecret {
  id              String    @id @default(cuid())
  slot            String    @unique
  label           String
  ciphertext      Bytes
  iv              Bytes
  publicConfig    Json
  enabled         Boolean   @default(true)
  hintJson        Json?
  lastVerifiedAt  DateTime?
  lastVerifyOk    Boolean?
  lastVerifyError String?
  updatedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AdminSetting {
  key       String   @id
  valueJson Json
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String?
  targetId   String?
  beforeJson Json?
  afterJson  Json?
  ip         String?
  createdAt  DateTime @default(now())
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorId])
}
